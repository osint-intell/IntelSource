# IntelSource Configuration
# Copy this file to .env and add your actual API tokens

# ipinfo.io API Token (get free token at https://ipinfo.io)
# Free tier: 50k requests/month
IPINFO_TOKEN=

# Shodan API Key (future feature)
SHODAN_API_KEY=

# Censys API Credentials (future feature)
CENSYS_API_ID=
CENSYS_API_SECRET=

# Optional: DNS Configuration
DNS_TIMEOUT=5
DNS_RETRIES=2

# Optional: WHOIS Timeout
WHOIS_TIMEOUT=10

# Optional: Output formatting
COLORIZE_OUTPUT=true
